{
  "info": {
    "name": "Smart Campus Operations Hub API",
    "_postman_id": "it3030-smart-campus-2026",
    "description": "IT3030 PAF Assignment – Smart Campus REST API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" }
  ],
  "item": [
    {
      "name": "Module B – Booking Management",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"resourceId\": 101,\n  \"startTime\": \"2026-04-28T09:00:00\",\n  \"endTime\": \"2026-04-28T11:00:00\",\n  \"purpose\": \"Team standup meeting\",\n  \"expectedAttendees\": 8\n}"
            }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/bookings/my?userId=1"
          }
        },
        {
          "name": "Get All Bookings (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/bookings/all"
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/bookings/1"
          }
        },
        {
          "name": "Approve Booking",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/bookings/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            }
          }
        },
        {
          "name": "Reject Booking with Reason",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/bookings/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"adminReason\": \"Room is under maintenance\"\n}"
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/bookings/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}"
            }
          }
        },
        {
          "name": "Delete Booking",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/bookings/1"
          }
        },
        {
          "name": "Create Conflicting Booking (Should Fail 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"resourceId\": 101,\n  \"startTime\": \"2026-04-28T09:30:00\",\n  \"endTime\": \"2026-04-28T10:30:00\",\n  \"purpose\": \"Overlapping meeting\",\n  \"expectedAttendees\": 3\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Module C – Incident Ticketing",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"resourceLocation\": \"Lab 3, Floor 2\",\n  \"category\": \"IT Equipment\",\n  \"description\": \"Projector is not working and shows black screen\",\n  \"priority\": \"HIGH\",\n  \"contactDetails\": \"ext. 2234\"\n}"
            }
          }
        },
        {
          "name": "Get My Tickets",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/tickets/my?userId=1"
          }
        },
        {
          "name": "Get All Tickets (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/tickets/all"
          }
        },
        {
          "name": "Get Ticket by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/tickets/1"
          }
        },
        {
          "name": "Update Ticket Status to IN_PROGRESS",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/tickets/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          }
        },
        {
          "name": "Resolve Ticket with Notes",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/tickets/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"resolutionNotes\": \"Replaced the projector bulb. Issue resolved.\"\n}"
            }
          }
        },
        {
          "name": "Assign Technician",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/tickets/1/assign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": 5\n}"
            }
          }
        },
        {
          "name": "Add Comment to Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/tickets/1/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorId\": 1,\n  \"authorName\": \"John Doe\",\n  \"content\": \"The projector has been flickering since yesterday morning.\"\n}"
            }
          }
        },
        {
          "name": "Get All Comments for Ticket",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/tickets/1/comments"
          }
        },
        {
          "name": "Edit Comment (Owner Only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/tickets/1/comments/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"content\": \"Updated: The projector has been flickering since Tuesday morning.\"\n}"
            }
          }
        },
        {
          "name": "Delete Comment (Owner Only)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/tickets/1/comments/1?userId=1"
          }
        },
        {
          "name": "Delete Ticket (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/tickets/1"
          }
        }
      ]
    }
  ]
}
